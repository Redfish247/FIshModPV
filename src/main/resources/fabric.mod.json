		"main": ["dev.fishmodpv.FishModPV"],
		"client": ["dev.fishmodpv.FishModPVClient"]
	},
	"depends": {
		"fabricloader": ">=0.18.4",
		"fabric-api": "*",
		"minecraft": "~26.1",
		"java": ">=25"
	}
}
